# Whitelist style ignore file

# Ignore everything
*

# Don't ignore the ignore
!.gitignore

# Don't ignore these files
!makefile
!start.sh
!issue-branch.sh
!backup-private.sh
!README.md
!resume.tex
!resume.cls
!AGENTS.md
!career/
!career/*.md

# Local application materials and sensitive notes must stay untracked.
/private/

# Don't ignore these directories
!.github/
!.github/workflows/
